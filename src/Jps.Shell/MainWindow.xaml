<ui:FluentWindow
    x:Class="Jps.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Jps.Shell.ViewModels"
    Title="JPS Tool Library"
    Icon="Assets/app.ico"
    Width="1320" Height="860" MinWidth="720" MinHeight="520"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    FontFamily="{StaticResource TextFont}"
    SizeChanged="OnSizeChanged">

    <ui:FluentWindow.DataContext>
        <vm:MainViewModel />
    </ui:FluentWindow.DataContext>

    <ui:FluentWindow.Resources>
        <!-- ============ Navigation rail items ============ -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="ToolTip" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Root" Background="Transparent">
                            <!-- Guide line that ties a group's tools together -->
                            <Border x:Name="Guide" Width="2" HorizontalAlignment="Left" Margin="17,0,0,0" Visibility="Collapsed"
                                    Background="#80E3051B" />
                            <Border x:Name="Pill" CornerRadius="9" Padding="12,8" Margin="0,0,6,0" Background="Transparent">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Tools are indented under their group, with the guide line -->
                            <DataTrigger Binding="{Binding IsTool}" Value="True">
                                <Setter TargetName="Pill" Property="Margin" Value="28,0,6,0" />
                                <Setter TargetName="Guide" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter TargetName="Pill" Property="Padding" Value="10,9" />
                                <Setter TargetName="Root" Property="Margin" Value="0,10,0,2" />
                            </DataTrigger>
                            <!-- Icon-only rail: no indent, no guide -->
                            <DataTrigger Binding="{Binding DataContext.IsNavCompact, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                <Setter TargetName="Pill" Property="Margin" Value="0" />
                                <Setter TargetName="Pill" Property="Padding" Value="10,9" />
                                <Setter TargetName="Guide" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource BrandRedFaintBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource BrandGradientBrush}" />
                                <Setter TargetName="Pill" Property="Effect" Value="{StaticResource RedGlow}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="ToolTip" Value="Show or hide these tools" />
                </DataTrigger>
                <!-- Tools of a collapsed group (the icon-only rail always shows every tool) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Header.IsExpanded}" Value="False" />
                        <Condition Binding="{Binding DataContext.IsNavCompact, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
                <!-- Icon-only rail: drop group headers -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsHeader}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsNavCompact, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactHidden" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsNavCompact, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One segment of the Dark | Light switch: the chosen one is a glowing red pill -->
        <Style x:Key="ThemeSegment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Seg" CornerRadius="15" Padding="14,6" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Seg" Property="Background" Value="{StaticResource BrandRedFaintBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Seg" Property="Background" Value="{StaticResource BrandGradientBrush}" />
                                <Setter TargetName="Seg" Property="Effect" Value="{StaticResource RedGlowSoft}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pulsing "live" dot for the connection pill -->
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:1.1" />
        </Storyboard>
    </ui:FluentWindow.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Atmosphere: red/ember light blooms + faint tech grid ============ -->
        <Grid Grid.RowSpan="4" IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle Fill="{StaticResource TechGridBrush}" />
            <Ellipse Width="900" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-380,-360,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#44E3051B" Offset="0" />
                        <GradientStop Color="#14E3051B" Offset="0.5" />
                        <GradientStop Color="#00E3051B" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="1000" Height="800" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-420,-460">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#33FF6A3D" Offset="0" />
                        <GradientStop Color="#108C0414" Offset="0.55" />
                        <GradientStop Color="#008C0414" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <ui:TitleBar Grid.Row="0" Title="JPS Tool Library">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ============ Top bar ============ -->
        <Border Grid.Row="1" Padding="18,4,18,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="44" Height="44">
                        <Ellipse Fill="#22E3051B" Effect="{StaticResource RedGlow}" />
                        <Image Source="pack://application:,,,/Assets/app.ico" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="Bold">
                            <Run Text="JPS " Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Run Text="TOOL LIBRARY" Foreground="{StaticResource BrandTitleBrush}" />
                        </TextBlock>
                        <TextBlock Text="Utilities for Juris  ·  LexisNexis Juris Professional Services" FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Theme switch: an obvious two-segment Dark | Light control -->
                <Border DockPanel.Dock="Right" Margin="12,0,0,0" Padding="3" CornerRadius="18" VerticalAlignment="Center"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1"
                        BorderBrush="{StaticResource GlassEdgeBrush}" ToolTip="Switch the app between dark and light">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="DarkMode" GroupName="Theme" Style="{StaticResource ThemeSegment}" Checked="OnThemeChosen" Tag="Dark">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="Dark" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="LightMode" GroupName="Theme" Style="{StaticResource ThemeSegment}" Checked="OnThemeChosen" Tag="Light">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="Light" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Connection pill -->
                <Border DockPanel.Dock="Right" Margin="12,0,0,0" Padding="12,7" CornerRadius="16" VerticalAlignment="Center" MaxWidth="300"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1"
                        BorderBrush="{StaticResource GlassEdgeBrush}" ToolTip="{Binding BackupText}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                              Visibility="{Binding State, Converter={StaticResource EnumToVisibility}, ConverterParameter=Connected}">
                            <Ellipse Fill="#3DDC84">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#3DDC84" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                                </Ellipse.Effect>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard Storyboard="{StaticResource Pulse}" />
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>
                        <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" Margin="0,0,8,0"
                                         Visibility="{Binding State, Converter={StaticResource EnumToVisibility}, ConverterParameter=Connecting}" />
                        <ui:SymbolIcon Symbol="ErrorCircle20" FontSize="15" Margin="0,0,6,0" Foreground="{StaticResource BrandRedBrightBrush}"
                                       Visibility="{Binding State, Converter={StaticResource EnumToVisibility}, ConverterParameter=Failed}" />
                        <ui:SymbolIcon Symbol="Warning20" FontSize="15" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding State, Converter={StaticResource EnumToVisibility}, ConverterParameter=NoCompanies}" />
                        <TextBlock Text="{Binding ConnectionText}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Building24" FontSize="18" Margin="0,0,8,0" Foreground="{StaticResource BrandRedBrightBrush}" />
                    <ComboBox Width="280" ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany}"
                              DisplayMemberPath="Display" ToolTip="Juris company" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Glowing divider under the top bar -->
        <Rectangle Grid.Row="1" Height="1" VerticalAlignment="Bottom" Fill="{StaticResource BrandHairlineBrush}" />

        <!-- ============ Navigation rail + page ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0DFFFFFF" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="300" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavCompact}" Value="True">
                                <Setter Property="Width" Value="64" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="10,10,16,16">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <Grid>
                                <!-- Group header: bold upper-case title, red accent bar, licensed count, chevron -->
                                <DockPanel Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisibility}}">
                                    <Border DockPanel.Dock="Left" Width="4" Height="18" CornerRadius="2" Margin="0,0,10,0"
                                            Background="{StaticResource BrandGradientBrush}" Effect="{StaticResource RedGlowSoft}" />
                                    <ui:SymbolIcon DockPanel.Dock="Right" FontSize="14" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="ChevronRight16" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Symbol" Value="ChevronDown16" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <Border DockPanel.Dock="Right" Padding="8,1" CornerRadius="9" VerticalAlignment="Center"
                                            Background="{StaticResource BrandRedSoftBrush}">
                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Title, Converter={StaticResource ToUpper}}" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DockPanel>
                                <!-- Tool / page item -->
                                <DockPanel Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="{Binding Icon}" FontSize="18" Margin="0,0,12,0"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <DockPanel Style="{StaticResource CompactHidden}">
                                        <ui:SymbolIcon DockPanel.Dock="Right" Symbol="LockClosed16" FontSize="13" Margin="8,0,0,0" Opacity="0.7"
                                                       Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ContentPresenter Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="3" Padding="18,7" Background="#0DFFFFFF" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel LastChildFill="False">
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Database20" FontSize="13" Margin="0,0,6,0" Foreground="{StaticResource BrandRedBrightBrush}" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding DatabaseText}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock DockPanel.Dock="Left" Margin="20,0,0,0" Text="{Binding BackupText}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock DockPanel.Dock="Right" Margin="0,0,20,0" FontSize="11.5">
                    <Hyperlink Command="{Binding OpenLicenseCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextDecorations="{x:Null}">
                        <Run Text="{Binding LicenseText, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
