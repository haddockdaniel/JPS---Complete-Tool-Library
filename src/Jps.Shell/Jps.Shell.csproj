<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>JPS Tool Library</AssemblyName>
    <RootNamespace>Jps.Shell</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF-UI: MIT licensed, free. Fluent (Windows 11) styling, Mica, light/dark themes. -->
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jps.Core\Jps.Core.csproj" />
    <ProjectReference Include="..\Jps.Tools\Jps.Tools.csproj" />
  </ItemGroup>

  <!-- Archive Bill Bulk Print's renderer: a separate exe copied next to this one. It carries its own ActiveReports runtime
       license (src\Jps.BillRenderer\JPS Bill Renderer.exe.licenses, the original tool's compiled licenses.licx re-keyed to
       "JPS BILL RENDERER.EXE"; see Licensing\licenses.licx for the source entries). -->
  <ItemGroup>
    <ProjectReference Include="..\Jps.BillRenderer\Jps.BillRenderer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\LexisNexisLogo.bmp" />
  </ItemGroup>

  <!-- Developer convenience: drop a license next to the exe if one was generated into the repo root. -->
  <ItemGroup>
    <None Include="..\..\JPS.license" Condition="Exists('..\..\JPS.license')" CopyToOutputDirectory="PreserveNewest" Link="JPS.license" Visible="false" />
  </ItemGroup>

</Project>
