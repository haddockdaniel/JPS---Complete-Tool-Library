<UserControl x:Class="Jps.Tools.Tools.HideOldBatches.HideOldBatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Jps.Tools.Common">
    <c:ToolFrame x:Name="Frame">
        <StackPanel>
            <Border Style="{StaticResource ToolCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ToolCardTitle}" Text="1  Pick the cut-off date" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Hide batches in accounting periods that ended before" />
                    <DatePicker x:Name="CutoffPicker" Width="220" HorizontalAlignment="Left" SelectedDateChanged="OnInputChanged" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="A period is hidden only when its whole period (as set up in Juris's accounting periods) ended before this date." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ToolCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ToolCardTitle}" Text="2  Choose the batch types" />
                    <c:CheckList x:Name="TypeList" MaxWidth="520" HorizontalAlignment="Left" MinWidth="360" Height="330"
                                 Placeholder="Search batch types" SelectionChanged="OnTypesChanged" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Only finished batches leave the batch tree: posted batches (credit memo and manual bill batches once nobody has them open). Unposted batches stay so they can still be opened and posted. The batches themselves are kept in Juris; they just no longer show in the tree." />
                </StackPanel>
            </Border>

            <DockPanel Style="{StaticResource ActionBar}">
                <ui:Button x:Name="HideButton" DockPanel.Dock="Right" Appearance="Primary"
                           Content="Hide old batches" Icon="{ui:SymbolIcon EyeOff24}" Click="OnHide" />
                <ui:Button x:Name="PreviewButton" DockPanel.Dock="Right" Margin="0,0,8,0"
                           Content="Preview batches" Icon="{ui:SymbolIcon DocumentTable24}" Click="OnPreview" />
            </DockPanel>
        </StackPanel>
    </c:ToolFrame>
</UserControl>
