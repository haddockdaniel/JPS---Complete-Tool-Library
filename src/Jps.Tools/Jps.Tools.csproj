<Project Sdk="Microsoft.NET.Sdk">

  <!-- Every JPS tool, in one assembly. Each tool is still licensed separately (by its catalog id);
       shared UI and helpers live in Common\ so tools stay small. -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>Jps.Tools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jps.Core\Jps.Core.csproj" />
    <Reference Include="System.Data" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- Archive Bill Bulk Print renders in a separate process, "JPS Bill Renderer.exe" (src\Jps.BillRenderer), through Juris's
       own JurisWrapper.dll. Nothing Juris-rendering-related is loaded into the Tool Library itself. -->

</Project>
